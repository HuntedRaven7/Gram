[Unit]
Description=Gram bootc installer
ConditionPathExists=/usr/local/bin/gram
StartLimitIntervalSec=120s
StartLimitBurst=2

[Service]
Type=simple
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=tty
StandardError=tty
ExecStart=/usr/local/bin/gram
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
